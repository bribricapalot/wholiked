# Server
# API server port (PORT is used as fallback, e.g. on PaaS hosts)
API_PORT=3001
# Public URL the browser uses (dev: the Vite dev server, which proxies to the API)
PUBLIC_URL=http://localhost:5173
# 32+ random chars — used to encrypt the ephemeral session (AES-256-GCM)
SESSION_SECRET=change-me-to-a-long-random-string

# Optional: without REDIS_URL an in-memory store with identical TTL semantics is used
# REDIS_URL=redis://localhost:6379

# TikTok Login Kit (https://developers.tiktok.com) — optional; without it, link-only mode
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Must be registered exactly like this in the TikTok developer portal
TIKTOK_REDIRECT_URI=http://localhost:5173/auth/tiktok/callback
# PKCE challenge encoding: hex (TikTok's documented variant) | base64url (RFC 7636) | off
TIKTOK_PKCE=hex
